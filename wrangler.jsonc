{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-entrepreneur-network",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-entrepreneur-network",
      "database_id": "3d524032-a74e-428e-802b-56e4aaee85fd"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
  // INVITE_CODE is set as a secret in the Cloudflare dashboard (or .dev.vars locally).
}
